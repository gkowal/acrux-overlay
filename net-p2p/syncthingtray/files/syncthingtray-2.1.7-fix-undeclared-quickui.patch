Fix compilation failure in syncthingapplet.cpp when SYNCTHINGWIDGETS_GUI_QTQUICK_MODE_DESKTOP
is not defined (m_quickUI was accessed unconditionally).

--- a/plasmoid/lib/syncthingapplet.cpp
+++ b/plasmoid/lib/syncthingapplet.cpp
@@ -595,9 +595,13 @@ bool SyncthingApplet::showFileBrowser(const QString &dirId)
 void SyncthingApplet::showIgnorePatterns(const QString &dirId)
 {
     if (auto row = 0; auto *const dir = m_data.connection()->findDirInfo(dirId, row)) {
+#if defined(SYNCTHINGWIDGETS_GUI_QTQUICK_MODE_DESKTOP)
         if (m_quickUI.has_value()) {
             m_quickUI->ui.editIgnorePatterns(dir->id, dir->displayName());
         } else {
             showCenteredDialog(QtGui::ignorePatternsDialog(*m_data.connection(), *dir));
         }
+#else
+        showCenteredDialog(QtGui::ignorePatternsDialog(*m_data.connection(), *dir));
+#endif
     }
 }
